	"item": [
		{
			"name": "Get Token",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const response = pm.response.text();\r",
							"pm.environment.set('token', response);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "exa-auth-plugin",
						"value": "{{token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{apiGatewayUrl}}/api/user/getusertoken?externalSystemId={{externalSystemId}}&secret={{externalSystemSecret}}&externalUserName={{externalUserName}}",
					"host": [
						"{{apiGatewayUrl}}"
					],
					"path": [
						"api",
						"user",
						"getusertoken"
					],
					"query": [
						{
							"key": "externalSystemId",
							"value": "{{externalSystemId}}"
						},
						{
							"key": "secret",
							"value": "{{externalSystemSecret}}"
						},
						{
							"key": "externalUserName",
							"value": "{{externalUserName}}"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "Upload document",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = JSON.parse(responseBody);\r",
							"pm.environment.set('documentId', jsonData.id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "exa-auth-plugin",
						"value": "{{token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/octet-stream",
						"type": "text"
					}
				],
				"body": {
					"mode": "file",
					"file": {
						"src": "/C:/Users/Marnixhp/OneDrive - 9altitudes/Desktop/Test Docs/dummy.pdf"
					}
				},
				"url": {
					"raw": "{{apiGatewayUrl}}/api/meta/document/content?name=dummy.pdf",
					"host": [
						"{{apiGatewayUrl}}"
					],
					"path": [
						"api",
						"meta",
						"document",
						"content"
					],
					"query": [
						{
							"key": "name",
							"value": "dummy.pdf"
						}
					]
				}
			},
			"response": []
		},
