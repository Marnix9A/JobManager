						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"source\": \"D365-FO\",\r\n  \"entityName\": \"CUSTCUSTOMERV3ENTITY\",\r\n  \"legalEntity\": \"DAT\",\r\n  \"fields\": {\r\n    \"CUSTOMERACCOUNT\": \"C-0000001\",\r\n    \"ORGANIZATIONNAME\": \"Sample Customer\",\r\n  }\r\n}",
